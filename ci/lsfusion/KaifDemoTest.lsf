MODULE KaifDemoTest;

REQUIRE MyCompanySa;

NAMESPACE KaifTest;

// Used only by the CI "Demo run" (.github/workflows/demo-run.yml), never in production: the scenario of the
// presentation through the API and the forms to take the screenshots of.

lastInvoice () = GROUP MAX Invoice i;
lastReturn () = GROUP MAX Bill b IF Invoicing.isCreditNote(b);
demoCustomer () = GROUP MAX LegalEntity c IF name(c) = 'أسواق النخبة';
demoWarehouse () = GROUP MAX Location l IF name(l) = 'المستودع الرئيسي';
// a desk sales type with a number series (the distributor type takes the numbers from the app)
deskInvoiceType () = GROUP MAX InvoiceType t IF numerator(t) AND billType(t) AND NOT t = Distribution.invoiceType();

firstProducts (Product p) = PARTITION SUM 1 IF p IS Product ORDER p;

locationNames () = GROUP CONCAT name(Location l), ' | ' ORDER l;

runScenario () {
    Kaif.loadDemoDataDo();
    IF Kaif.demoLoadError() THEN throwException('Demo data: ' + Kaif.demoLoadError());
    IF NOT demoWarehouse() THEN throwException('Demo warehouse not found, locations: ' + (OVERRIDE locationNames(), '-'));
    IF NOT demoCustomer() THEN throwException('Demo customer not found');
    NEWSESSION {
        NEW i = Invoice {
            type(i) <- deskInvoiceType();
            dateTime(i) <- currentDateTime();
            customer(i) <- demoCustomer();
            location(i) <- demoWarehouse();
            FOR firstProducts(Product p) <= 3 ORDER p INLINE NEW il = InvoiceLine DO {
                invoice(il) <- i;
                Distribution.fillLine(il, p, NUMERIC[16,3](24 * firstProducts(p)), salesPrice(p));
            }
            ready(i) <- TRUE;
            Distribution.newPayment(NULL, 'demo-p1', 'DEMO-R1', currentDateTime(), customer(i), 500.00, 'cash', i, NULL);
        }
        APPLY;
        IF canceled() THEN throwException('Invoice: ' + applyMessage());
    }
    NEWSESSION {
        NEW b = Bill {
            type(b) <- billType(type(lastInvoice()));
            dateTime(b) <- currentDateTime();
            vendor(b) <- demoCustomer();
            location(b) <- demoWarehouse();
            vendorReference(b) <- STRING[30](number(lastInvoice()));
            FOR firstProducts(Product p) = 1 INLINE NEW bl = BillLine DO {
                bill(bl) <- b;
                Distribution.fillLine(bl, p, 3.0, salesPrice(p));
            }
            ready(b) <- TRUE;
            Distribution.matchDebts(b, vendor(b), amount[Bill](b), lastInvoice());
        }
        APPLY;
        IF canceled() THEN throwException('Return: ' + applyMessage());
    }
}

// packing: 100 boxes of the premium tea from the loose tea, bags and boxes (bill of materials of the demo data)
packedProduct () = GROUP MAX Product p IF dataName(p) = 'شاي الكيف الأصلي فاخر 100 كيس';
lastPacking () = GROUP MAX ManufacturingOrder o;

runPacking () {
    NEWSESSION {
        NEW o = ManufacturingOrder {
            type(o) <- GROUP MAX ManufacturingOrderType t IF NOT unbuild(t);
            item(o) <- packedProduct();
            bom(o) <- dataDefaultBom(packedProduct());
            company(o) <- defaultCompany();
            materialsLocation(o) <- demoWarehouse();
            productsLocation(o) <- demoWarehouse();
            scheduledDateTime(o) <- currentDateTime();
            fillByQuantity(o, 100.0);
            consumed(ConsumedLine l) <- toConsume(l) WHERE manufacturingOrder(l) = o;
            produced(FinishedLine l) <- toProduce(l) WHERE manufacturingOrder(l) = o;
            executionDateTime(o) <- currentDateTime();
            done(o) <- TRUE;
        }
        APPLY;
        IF canceled() THEN throwException('Packing: ' + applyMessage() + ' / warehouse: ' + (OVERRIDE name(demoWarehouse()), '-')
            + ' / order location: ' + (OVERRIDE name(productsLocation(lastPacking())), '-'));
    }
}

// ---------- distributor: login d01 / test123 for the first distributor (the app scenario in ci/demo/distributor.py) ----------

demoDistributor () = GROUP MAX Employee e IF Distribution.documentPrefix(e) = 'D01';

setupDistributor () {
    NEWSESSION {
        FOR Employee e = demoDistributor() DO {
            login(e) <- 'd01';
            calculateBase64Hash('SHA-256', 'test123');
            sha256Password(e) <- calculatedHash();
        }
        APPLY;
    }
}

vanOf () = Distribution.vanLocation(demoDistributor());
mobileInvoice () = Distribution.invoiceMobile('test-inv-1');
mobileReturn () = Distribution.billMobile('test-ret-1');
mobilePayment () = Distribution.incomingPaymentMobile('test-pay-1');
mobileClosing () = GROUP MAX Distribution.Closing c IF Distribution.mobileId(c) = 'test-clo-1';

distributorCheck () {
    EXPORT JSON FROM
        invoiceNumber = number(mobileInvoice()),
        invoiceAmount = amount(mobileInvoice()),
        invoiceVat = taxAmount(mobileInvoice()),
        invoiceLines = (GROUP SUM 1 IF invoice(InvoiceLine l) = mobileInvoice()),
        invoicePaid = paid(mobileInvoice()),
        invoiceLocation = name(location(mobileInvoice())),
        returnNumber = number(mobileReturn()),
        returnAmount = amount[Bill](mobileReturn()),
        returnLines = (GROUP SUM 1 IF bill(BillLine l) = mobileReturn()),
        paymentAmount = amount(mobilePayment()),
        visits = (GROUP SUM 1 IF Distribution.distributor(Distribution.Visit v) = demoDistributor()),
        closingNumber = Distribution.number(mobileClosing()),
        closingLines = (GROUP SUM 1 IF Distribution.closing(Distribution.ClosingLine l) = mobileClosing()),
        closingDifferences = Distribution.countDifferences(mobileClosing()),
        vanStock = (GROUP SUM onHand(vanOf(), Product p)),
        firstItemVanStock = onHand(vanOf(), (GROUP MAX Product p IF dataName(p) = 'شاي الكيف الأصلي فاخر 100 كيس'));
} @@api;

// ---------- payroll: a Saudi employee (3 years, full month) and a non-Saudi hired on the 16th ----------

lastPayslipBatch () = GROUP MAX PayslipBatch b;
payslipOf (STRING first) = GROUP MAX Payslip p IF MasterData.firstName(employee(p)) = first AND batch(p) = lastPayslipBatch();
lineOf (STRING first, STRING sid) = total(payslipOf(first), categorySa(sid));

runPayroll () {
    NEWSESSION {
        NEW e = Employee {
            MasterData.firstName(e) <- 'سعد'; MasterData.lastName(e) <- 'الدوسري';
            legalEntity(e) <- defaultCompany();
            nationality(e) <- GROUP MAX Country c IF id(c) = 'SA' OR alpha2(c) = 'SA';
            hireDateSa(e) <- subtract(currentDate(), 1094);
            basicSalarySa(e) <- 6000.00; housingAllowanceSa(e) <- 1500.00; transportAllowanceSa(e) <- 500.00;
        }
        NEW e = Employee {
            MasterData.firstName(e) <- 'راجيش'; MasterData.lastName(e) <- 'كومار';
            legalEntity(e) <- defaultCompany();
            nationality(e) <- GROUP MAX Country c IF id(c) = 'IN' OR alpha2(c) = 'IN';
            hireDateSa(e) <- sum(firstDayOfMonth(currentDate()), 15);
            basicSalarySa(e) <- 3000.00; housingAllowanceSa(e) <- 750.00;
        }
        NEW b = PayslipBatch {
            name(b) <- 'رواتب الشهر';
            period(b) <- interval(firstDayOfMonth(currentDate()), lastDayOfMonth(currentDate()));
            company(b) <- defaultCompany();
            type(b) <- GROUP MAX PayslipType t;
            FOR legalEntity(Employee e) = defaultCompany() AND basicSalarySa(e) INLINE NEW p = Payslip DO {
                batch(p) <- b; employee(p) <- e; period(p) <- period(b); company(p) <- company(b); type(p) <- type(b);
            }
        }
        APPLY;
        IF canceled() THEN throwException('Payroll: ' + applyMessage());
    }
    NEWSESSION {
        FOR batch(Payslip p) = lastPayslipBatch() DO generate(p);
        APPLY;
        IF canceled() THEN throwException('Payroll generate: ' + applyMessage());
    }
}

payrollCheck () {
    EXPORT JSON FROM
        saudiBasic = lineOf('سعد', 'basic'), saudiHousing = lineOf('سعد', 'housing'), saudiTransport = lineOf('سعد', 'transport'),
        saudiGosi = lineOf('سعد', 'gosi'), saudiGosiCompany = lineOf('سعد', 'gosiCompany'),
        saudiNet = netWage(payslipOf('سعد')),
        saudiServiceYears = serviceYearsSa(GROUP MAX Employee e IF MasterData.firstName(e) = 'سعد'),
        saudiEosTermination = eosFullSa(GROUP MAX Employee e IF MasterData.firstName(e) = 'سعد'),
        saudiEosResignation = eosResignationSa(GROUP MAX Employee e IF MasterData.firstName(e) = 'سعد'),
        saudiLeaveAccrued = accruedLeaveSa(GROUP MAX Employee e IF MasterData.firstName(e) = 'سعد'),
        foreignBasic = lineOf('راجيش', 'basic'), foreignHousing = lineOf('راجيش', 'housing'),
        foreignGosi = lineOf('راجيش', 'gosi'), foreignGosiCompany = lineOf('راجيش', 'gosiCompany'),
        foreignNet = netWage(payslipOf('راجيش')),
        monthDays = daysBetweenDates(lastDayOfMonth(currentDate()), firstDayOfMonth(currentDate())) + 1,
        foreignDaysWorked = daysBetweenDates(lastDayOfMonth(currentDate()), sum(firstDayOfMonth(currentDate()), 15)) + 1,
        isSaudiFound = TRUE IF (GROUP SUM 1 IF isSaudiSa(Employee e)),
        payslips = (GROUP SUM 1 IF batch(Payslip p) = lastPayslipBatch());
} @@api;

// ---------- VAT return of the current month ----------

vatCheck () {
    LOCAL df = DATE (); LOCAL dt = DATE ();
    df() <- firstDayOfMonth(currentDate()); dt() <- lastDayOfMonth(currentDate());
    EXPORT JSON FROM
        box1Amount = amountBox(VatReturnBox.b1, defaultCompany(), df(), dt()),
        box1Adjustment = adjustmentBox(VatReturnBox.b1, defaultCompany(), df(), dt()),
        box1Vat = vatBox(VatReturnBox.b1, defaultCompany(), df(), dt()),
        box7Amount = amountBox(VatReturnBox.b7, defaultCompany(), df(), dt()),
        box12Vat = vatBox(VatReturnBox.b12, defaultCompany(), df(), dt()),
        box13VatDue = vatBox(VatReturnBox.b13, defaultCompany(), df(), dt()),
        salesInvoices = (GROUP SUM 1 IF inPeriodSa(Invoice i, defaultCompany(), df(), dt())),
        salesVatSum = (GROUP SUM vatSa(Invoice i) IF inPeriodSa(i, defaultCompany(), df(), dt()) AND NOT isRefund(i)),
        creditNotesVatSum = (GROUP SUM vatSa(Bill b) IF inPeriodSa(b, defaultCompany(), df(), dt()) AND isCreditNote(b));
} @@api;

looseTea () = GROUP MAX Product p IF dataName(p) = 'شاي أسود كيني سائب (مستورد)';
looseTeaPrice () = GROUP MAX price(InCostLedger il) IF product(il) = looseTea();
consumedLedgers () = GROUP SUM 1 IF manufacturingOrder(line(ConsumedOutCostLedger l)) = lastPacking();
consumedAmount () = GROUP SUM amount(ConsumedOutCostLedger l) IF manufacturingOrder(line(l)) = lastPacking();
costBeforeRecalc = DATA NUMERIC[14,2] ();

scenarioRan = DATA BOOLEAN ();

runDemo () {
    IF NOT scenarioRan() THEN {
        runScenario();
        runPacking();
        setupDistributor();
        runPayroll();
        NEWSESSION { costBeforeRecalc() <- totalCost(lastPacking()); APPLY; }
        Inventory.recalculateCost(subtract(currentDate(), 1));
        NEWSESSION { scenarioRan() <- TRUE; APPLY; }
    }
    EXPORT JSON FROM
        items = (GROUP SUM 1 IF Product p IS Product),
        customers = (GROUP SUM 1 IF isCustomer(LegalEntity c)),
        invoice = number(lastInvoice()),
        invoiceAmount = amount(lastInvoice()),
        invoicePaid = paid(lastInvoice()),
        zatcaQR = zatcaQR(lastInvoice()),
        amountWords = amountWordsSa(lastInvoice()),
        creditNote = number(lastReturn()),
        creditNoteAmount = amount[Bill](lastReturn()),
        warehouseOnHand = (GROUP SUM onHand(demoWarehouse(), Product p)),
        packingOrder = number(lastPacking()),
        packingTotalCost = totalCost(lastPacking()),
        packingCostBeforeRecalc = costBeforeRecalc(),
        looseTeaPrice = looseTeaPrice(),
        consumedLedgers = consumedLedgers(),
        consumedAmount = consumedAmount(),
        packingUnitCost = NUMERIC[14,4](totalCost(lastPacking()) / 100.0),
        packingExpectedUnitCost = 7.00,
        hasLogo = TRUE IF logicsLogo(),
        appCaption = logicsCaption(),
        appDisplayName = displayName(),
        looseTeaLeftKg = onHand(demoWarehouse(), (GROUP MAX Product p IF dataName(p) = 'شاي أسود كيني سائب (مستورد)'));
} @@api;

invoicePdf () {
    invoiceTemplate() <- GROUP MAX InvoiceTemplate tm IF template(tm) = 'TaxInvoiceSa.jrxml';
    PRINT Invoicing.printInvoice OBJECTS o = lastInvoice() PDF TO exportFile;
} @@api;

receiptPdf () {
    invoiceTemplate() <- GROUP MAX InvoiceTemplate tm IF template(tm) = 'TaxInvoiceReceiptSa.jrxml';
    PRINT Invoicing.printInvoice OBJECTS o = lastInvoice() PDF TO exportFile;
} @@api;

creditNotePdf () {
    billTemplate() <- GROUP MAX BillTemplate tm IF template(tm) = 'CreditNoteSa.jrxml';
    PRINT Invoicing.printBill OBJECTS o = lastReturn() PDF TO exportFile;
} @@api;

// the next web client start shows this form (the screenshots)
demoForm = DATA TEXT ();
setDemoForm (TEXT f) { NEWSESSION { demoForm() <- f; APPLY; } } @@api;

onWebClientStarted () + {
    IF demoForm() THEN EVAL 'run() \{ ' + demoForm() + '; \}';
}
