MODULE MyCompanySa;

// Al-Kaif Al-Asli (Kaif Original) - Kingdom of Saudi Arabia localization
// (VAT 15%, seller/buyer VAT numbers, national address, ZATCA phase 1 QR code, bilingual tax invoice)
// To enable: logics.topModule = MyCompanySa

REQUIRE MyCompany, DefaultData, SystemEvents,
        PartnerSa,
        TaxInitialSa, CountryInitialSa,
        ZatcaQR,
        InvoicePrintSa, InvoicePrintInitialSa, CreditNotePrintSa, CreditNotePrintInitialSa, InvoiceSendSa, VatReturnSa, PosReceiptSa,
        EmployeeSa, PayrollSa, RolesSa,
        ImportShipmentSa, LotExpirySa, EcommerceSa, TrialSa, DemoDataSa,
        Distribution, DistributionInitial;

// The first start of the Saudi edition loads the default data (document types, taxes, templates,
// roles, distribution types), so a new company starts with a ready system. The result is written to
// the server log (checked by the CI start test).
onFirstStarted () + {
    fillDefaultData();
    IF GROUP SUM 1 IF InvoiceType t IS InvoiceType THEN
        printToLog('Kaif: default data loaded', 'start', 'info');
    ELSE
        printToLog('Kaif: ERROR default data was not loaded: ' + (OVERRIDE applyMessage(), ''), 'start', 'error');
}

// date and time without AM / PM (in the right-to-left interface "3:58 PM" mixes with the date): 24 hours,
// only when not set, so a format chosen in Administration stays
onStarted () + {
    NEWSESSION {
        IF NOT defaultUserDateFormat() THEN defaultUserDateFormat() <- 'dd/MM/yyyy';
        IF NOT defaultUserTimeFormat() THEN defaultUserTimeFormat() <- 'HH:mm';
        APPLY;
    }
}
