MODULE InvoicePrintSa;

REQUIRE InvoicePrint, InvoicePrintDebt, ZatcaQR, UtilsSa;

NAMESPACE Invoicing;

// Saudi specific data for the bilingual (Arabic / English) tax invoice
crNumberCompanySa (Invoice i) = crNumberSa(company(i));
nationalAddressCompanySa (Invoice i) = nationalAddressSa(company(i));
nationalAddressCustomerSa (Invoice i) = nationalAddressSa(customer(i));
crNumberCustomerSa (Invoice i) = crNumberSa(customer(i));
amountWordsSa 'Amount in words' (Invoice i) = tafqitSar(amount(i));

EXTEND FORM printInvoice
    PROPERTIES(o) sellerVatNumberSa, buyerVatNumberSa, crNumberCompanySa, crNumberCustomerSa,
                  nationalAddressCompanySa, nationalAddressCustomerSa,
                  isSimplifiedSa, zatcaQR, amountWordsSa
;
