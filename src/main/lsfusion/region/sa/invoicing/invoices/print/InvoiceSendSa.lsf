MODULE InvoiceSendSa;

REQUIRE InvoicePrintSa, InvoicePrintInitialSa, Invoice, InvoiceDebt, Partner, Company, Utils;

NAMESPACE Invoicing;

// Sending the invoice to the customer:
//  - by email: the PDF of the tax invoice (from the mail account in Administration -> Mail)
//  - by WhatsApp: opens WhatsApp (web or app) with a message to the phone of the customer: number, date,
//    amount and amount in words (WhatsApp links cannot attach a file: send the PDF from the chat if needed)

phoneDigitsSa = FORMULA STRING 'regexp_replace(($1), \'[^0-9]\', \'\', \'g\')';

// Saudi mobile numbers to the international format: 05xxxxxxxx / 5xxxxxxxx / 00966... -> 9665xxxxxxxx
whatsappPhoneSa (STRING phone) = CASE
    WHEN left(phoneDigitsSa(phone), 2) = '00' THEN substrFrom(phoneDigitsSa(phone), 3)
    WHEN left(phoneDigitsSa(phone), 2) = '05' AND length(phoneDigitsSa(phone)) = 10 THEN '966' + substrFrom(phoneDigitsSa(phone), 2)
    WHEN left(phoneDigitsSa(phone), 1) = '5' AND length(phoneDigitsSa(phone)) = 9 THEN '966' + phoneDigitsSa(phone)
    ELSE phoneDigitsSa(phone);

customerPhoneSa 'Phone' (Invoice i) = whatsappPhoneSa(phone(customer(i)));
customerEmailSa 'Email' (Invoice i) = email(customer(i));
remainingSa (Invoice i) = amount(i) (-) paid(i);

whatsappTextSa (Invoice i) = CONCAT '\n',
    'السلام عليكم ' + name(customer(i)),
    'فاتورة رقم: ' + number(i),
    'التاريخ: ' + toDateDDMMYYYY(date(i)),
    'الإجمالي شامل الضريبة: ' + amount(i) + ' ريال',
    amountWordsSa(i),
    'المتبقي: ' + remainingSa(i) + ' ريال' IF remainingSa(i) > 0,
    'شكراً لتعاملكم مع ' + fullName(company(i));

sendWhatsAppSa 'WhatsApp' (Invoice i) {
    IF NOT customerPhoneSa(i) THEN {
        MESSAGE 'The customer has no phone number';
        RETURN;
    }
    urlEncode(TEXT(whatsappTextSa(i)));
    open(LINK('https://wa.me/' + customerPhoneSa(i) + '?text=' + urlEncoded()), NULL, TRUE);
}

invoicePdfSa = DATA LOCAL FILE ();

sendEmailSa 'Email' (Invoice i) {
    IF NOT customerEmailSa(i) THEN {
        MESSAGE 'The customer has no email';
        RETURN;
    }
    invoiceTemplate() <- GROUP MAX InvoiceTemplate tm IF template(tm) = 'TaxInvoiceSa.jrxml';
    PRINT Invoicing.printInvoice OBJECTS o = i PDF TO invoicePdfSa;
    EMAIL
        SUBJECT 'فاتورة ضريبية رقم ' + number(i) + ' - ' + fullName(company(i))
        TO customerEmailSa(i)
        BODY '<div dir="rtl">' + replace(whatsappTextSa(i), '\n', '<br>') + '</div>'
        ATTACH invoicePdfSa() NAME 'invoice-' + number(i);
    MESSAGE '{kaif.invoice.sentTo} ' + customerEmailSa(i);
}

EXTEND FORM invoice PROPERTIES(i) sendWhatsAppSa, sendEmailSa;

DESIGN invoice {
    secondaryActions {
        MOVE PROPERTY(sendWhatsAppSa(i)) { valueClass = 'btn-success'; }
        MOVE PROPERTY(sendEmailSa(i)) { valueClass = 'btn-secondary'; }
    }
}
